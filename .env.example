# StudySphere AI - Configuration Template
# Copy this file to .env and adjust variables as needed

# Application Settings
APP_NAME="StudySphere AI"
APP_ENV="production"
HOST="0.0.0.0"
PORT=8000
SECRET_KEY="studysphere-secret-key-change-in-production"

# AI Model Provider: gemini | openai | ollama
DEFAULT_MODEL_PROVIDER="gemini"

# Google Gemini Settings (Get key at https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="models/text-embedding-004"

# OpenAI Settings (Get key at https://platform.openai.com/)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Ollama / Local Model Settings (Run ollama run llama3)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# RAG & Chunking Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_CHUNKS=4
SIMILARITY_THRESHOLD=0.35

# Storage Directories
UPLOAD_DIR="./data/uploads"
CHROMA_PERSIST_DIR="./data/chroma_db"
MAX_UPLOAD_SIZE_MB=25

# Simulation Mode (Allows full test run & UI exploration without API key)
ENABLE_SIMULATION_MODE=true
